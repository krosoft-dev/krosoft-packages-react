{
  "name": "@krosoft/react",
  "version": "0.0.1",
  "description": "Krosoft shared React package",
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint .",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}'",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krosoft-dev/krosoft-packages-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "peerDependencies": {
    "@krosoft/core": ">=0.0.1",
    "next-themes": ">=0.4.6",
    "react": ">=18.3.1",
    "react-i18next": ">=17.0.8"
  },
  "peerDependenciesMeta": {
    "next-themes": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@krosoft/core": "^0.0.37",
    "@krosoft/tooling-eslint-react": "^0.0.18",
    "@krosoft/tooling-prettier": "^0.0.14",
    "@krosoft/tooling-tsconfig-react": "^0.0.10",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "autoprefixer": "^10.5.0",
    "jsdom": "^26.1.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
